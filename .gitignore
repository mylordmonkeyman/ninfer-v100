# Build
build/
build-*/
cmake-build-*/
*.o
*.obj
*.so
*.a
compile_commands.json
CMakeUserPresets.json
.cache/

# CUDA / profiling artifacts
*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite

# Python tooling
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Weight artifacts (large; produced by offline tooling)
*.qus
*.bin
*.safetensors
*.gguf
*.ninfer
*.ninfer.conversion.json
/models/
out/

# Local workspace and transient runtime output
/.local/
/temp/
/temp-*/
/tmp/
/tmp-*/
/AGENTS.override.md
/logs/
*.log
*.tmp
/core
/core.*

# Measurement raw corpora & intermediates (large; produced by offline tooling).
# The small final frequency stats under fixtures/ranking/ ARE tracked; the rest is ignored.
tools/freq_corpus/fixtures/*
!tools/freq_corpus/fixtures/ranking/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
profiles/
.chatgpt/
.impeccable/

# Local production supervisor state (configuration may contain credentials)
/supervisor.prod.json
# ...and any backup or temp beside it: save_config_json writes .tmp, and a
# hand-made .bak of a pre-api-key-file config still holds the key inline.
/supervisor.prod.json.*
/supervisor.*.tray.json
/supervisor-logs/

# Claude Code personal/local settings (may contain API tokens)
.claude/settings.local.json
